<?xml version="1.0" encoding="UTF-8"?>
<!-- Deny only demo_data.json over HTTP; CSS/JS under assets/ must remain readable for wp_enqueue_*. -->
<configuration>
  <location path="demo_data.json">
    <system.webServer>
      <security>
        <authorization>
          <deny users="*" />
        </authorization>
      </security>
    </system.webServer>
  </location>
</configuration>
