FROM python:3.11-slim

WORKDIR /app
COPY lib/ /app/lib/
COPY patcherly_agent.py /app/patcherly_agent.py
COPY patcherly_cli.py /app/patcherly_cli.py
COPY oauth_client.py /app/oauth_client.py
COPY credential_store.py /app/credential_store.py
COPY sanitizer.py /app/sanitizer.py
COPY context_collector.py /app/context_collector.py
COPY context_consent.py /app/context_consent.py
COPY backup_manager.py /app/backup_manager.py
COPY patch_applicator.py /app/patch_applicator.py
COPY queue_manager.py /app/queue_manager.py
RUN python -m pip install --upgrade pip \
    && pip install --no-cache-dir httpx PyYAML python-dotenv

ENV SERVER_URL=http://server:8000
CMD ["python", "/app/patcherly_agent.py", "--server", "${SERVER_URL}"]
